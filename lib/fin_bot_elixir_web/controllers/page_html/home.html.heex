<div class="min-h-screen bg-background text-foreground">
  <nav class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
      <.logo />
      <div class="flex flex-row gap-2">
        <.link href={FinBotWeb.Helpers.WhatsApp.share_link("15551498199", gettext("I want to use FinBot"))}>
          <button class="px-6 py-2 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors">
            {gettext("Start Chatting")}
          </button>
        </.link>
        <.link navigate={~p"/auth/google"}>
          <button class="px-6 py-2 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors">
            {gettext("Login")}
          </button>
        </.link>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-20 md:py-32 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight text-balance">
          {gettext("Stop tracking your money. Start talking to it.")}
        </h1>
        <p class="text-xl text-muted-foreground mb-8 leading-relaxed text-pretty max-w-xl">
          {gettext(
            "The first finance bot that actually answers you. No tedious forms, no rigid categories. Just chat via WhatsApp and get instant insights with AI."
          )}
        </p>
        <.link href={FinBotWeb.Helpers.WhatsApp.share_link("15551498199", gettext("I want to use FinBot"))} class="px-8 py-4 rounded-lg bg-primary text-primary-foreground font-semibold text-lg hover:bg-primary/90 transition-all transform hover:scale-105 flex items-center gap-2 w-fit">
          {gettext("Start Chatting Now")}
          <span class="text-sm">({gettext("No account needed")})</span>
        </.link>
      </div>
      <div class="flex justify-center">
        <div class="relative w-full max-w-sm">
          <div class="rounded-3xl border-8 border-muted bg-black p-3 shadow-2xl">
            <div class="rounded-2xl bg-gradient-to-b from-muted-foreground to-background overflow-hidden h-96 flex flex-col">
              <div class="bg-green-900/50 text-white px-4 py-3 flex items-center gap-3">
                <img src="images/finbot_logo_blue.png" alt="FinBot Logo" class="w-8 h-8 rounded-full" />
                <div>
                  <p class="font-semibold text-sm">{gettext("FinBot")}</p>
                  <p class="text-xs opacity-75">{gettext("Active now")}</p>
                </div>
              </div>
              <div class="flex-1 px-4 py-4 space-y-4 overflow-y-auto bg-background">
                <div class="flex justify-end">
                  <div class="bg-primary text-primary-foreground rounded-2xl rounded-tr-sm px-4 py-2 max-w-xs text-sm">
                    {gettext("How much did I spend on coffee in Florianopolis this month?")}
                  </div>
                </div>
                <div class="flex justify-start gap-2">
                  <div class="space-y-2 max-w-xs">
                    <div class="bg-card text-foreground rounded-2xl rounded-tl-sm px-4 py-3 text-sm">
                      <div class="mb-2 font-semibold text-primary">{gettext("Coffee Spending")}</div>
                      <div class="bg-muted/30 rounded p-2 mb-2 text-xs">
                        <div class="flex justify-between mb-1">
                          <span>{gettext("This Month")}</span>
                          <span class="text-primary font-bold">$47.50</span>
                        </div>
                        <div class="w-full bg-muted h-1 rounded-full overflow-hidden">
                          <div class="bg-primary h-full" style="width:65%"></div>
                        </div>
                      </div>
                      <p class="text-xs text-muted-foreground">
                        {gettext(
                          "You are spending about 23% more than usual. Consider checking your daily coffee stops!"
                        )}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="bg-card border-t border-border px-3 py-2 flex items-center gap-2">
                <input
                  type="text"
                  placeholder={gettext("Type a message...")}
                  class="flex-1 bg-muted rounded-full px-4 py-2 text-sm text-foreground placeholder-muted-foreground outline-none"
                  readonly
                />
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-chevron-right w-5 h-5 text-primary"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 border-t border-border">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          {gettext("Ask Anything About Your Finances")}
        </h2>
        <p class="text-lg text-muted-foreground">
          {gettext("Questions that other finance apps can't answer, FinBot answers instantly.")}
        </p>
      </div>
      <div class="max-w-2xl mx-auto mb-12">
        <div class="relative">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-search absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground"
            aria-hidden="true"
          >
            <path d="m21 21-4.34-4.34" />
            <circle cx="11" cy="11" r="8"></circle>
          </svg>
          <input
            type="text"
            placeholder={gettext("Ask anything about your finances...")}
            class="w-full pl-12 pr-6 py-4 rounded-full bg-card border border-border text-foreground placeholder-muted-foreground focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
            readonly
          />
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-lg bg-card border border-border hover:border-primary/50 transition-colors cursor-pointer group">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-search w-4 h-4 text-primary"
                aria-hidden="true"
              >
                <path d="m21 21-4.34-4.34" />
                <circle cx="11" cy="11" r="8"></circle>
              </svg>
            </div>
            <p class="text-foreground font-medium group-hover:text-primary transition-colors">
              {gettext("Am I spending more on deliveries than last month?")}
            </p>
          </div>
        </div>
        <div class="p-4 rounded-lg bg-card border border-border hover:border-primary/50 transition-colors cursor-pointer group">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-search w-4 h-4 text-primary"
                aria-hidden="true"
              >
                <path d="m21 21-4.34-4.34" />
                <circle cx="11" cy="11" r="8"></circle>
              </svg>
            </div>
            <p class="text-foreground font-medium group-hover:text-primary transition-colors">
              {gettext("Can I afford that weekend trip?")}
            </p>
          </div>
        </div>
        <div class="p-4 rounded-lg bg-card border border-border hover:border-primary/50 transition-colors cursor-pointer group">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-search w-4 h-4 text-primary"
                aria-hidden="true"
              >
                <path d="m21 21-4.34-4.34" />
                <circle cx="11" cy="11" r="8"></circle>
              </svg>
            </div>
            <p class="text-foreground font-medium group-hover:text-primary transition-colors">
              {gettext("What's my biggest expense category?")}
            </p>
          </div>
        </div>
        <div class="p-4 rounded-lg bg-card border border-border hover:border-primary/50 transition-colors cursor-pointer group">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-search w-4 h-4 text-primary"
                aria-hidden="true"
              >
                <path d="m21 21-4.34-4.34" />
                <circle cx="11" cy="11" r="8"></circle>
              </svg>
            </div>
            <p class="text-foreground font-medium group-hover:text-primary transition-colors">
              {gettext("How much have I saved this month?")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 border-t border-border">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          {gettext("Designed for Modern Finance")}
        </h2>
        <p class="text-lg text-muted-foreground">
          {gettext("Everything you need to understand your money, at your fingertips.")}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="relative p-8 rounded-2xl bg-gradient-to-br from-primary/20 to-transparent border border-border hover:border-primary/50 transition-all hover:shadow-lg group">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-message-square w-6 h-6 text-primary"
                aria-hidden="true"
              >
                <path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-foreground">{gettext("Frictionless Input")}</h3>
            <p class="text-muted-foreground leading-relaxed">
              {gettext("Voice notes, photos of receipts, or simple text. The bot understands it all.")}
            </p>
          </div>
        </div>
        <div class="relative p-8 rounded-2xl bg-gradient-to-br from-secondary/20 to-transparent border border-border hover:border-primary/50 transition-all hover:shadow-lg group">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-zap w-6 h-6 text-primary"
                aria-hidden="true"
              >
                <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-foreground">{gettext("Shadow Onboarding")}</h3>
            <p class="text-muted-foreground leading-relaxed">
              {gettext("Start recording in seconds. Claim your full dashboard whenever you're ready.")}
            </p>
          </div>
        </div>
        <div class="relative p-8 rounded-2xl bg-gradient-to-br from-primary/20 to-transparent border border-border hover:border-primary/50 transition-all hover:shadow-lg group">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-lock w-6 h-6 text-primary"
                aria-hidden="true"
              >
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-foreground">{gettext("Privacy First")}</h3>
            <p class="text-muted-foreground leading-relaxed">
              {gettext("Your financial data, encrypted and protected with enterprise-grade security.")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 border-t border-border">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          {gettext("Your Dashboard, Reimagined")}
        </h2>
        <p class="text-lg text-muted-foreground">
          {gettext("Clean, minimal, and packed with insights.")}
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl border border-border bg-card/50">
          <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-trending-down w-4 h-4 text-primary"
                aria-hidden="true"
              >
                <path d="M16 17h6v-6"></path>
                <path d="m22 17-8.5-8.5-5 5L2 7"></path>
              </svg>
            </div>
            {gettext("Category Limits")}
          </h3>
          <div class="space-y-6">
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-coffee w-4 h-4 text-primary"
                    aria-hidden="true"
                  >
                    <path d="M10 2v2"></path>
                    <path d="M14 2v2"></path>
                    <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path>
                    <path d="M6 2v2"></path>
                  </svg>
                  <span class="font-medium">{gettext("Coffee")}</span>
                </div>
                <span class="text-sm font-semibold text-primary">$47.50</span>
              </div>
              <div class="w-full bg-muted h-2 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all" style="width:65%"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-utensils w-4 h-4 text-primary"
                    aria-hidden="true"
                  >
                    <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                    <path d="M7 2v20"></path>
                    <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
                  </svg>
                  <span class="font-medium">{gettext("Food")}</span>
                </div>
                <span class="text-sm font-semibold text-primary">$312.80</span>
              </div>
              <div class="w-full bg-muted h-2 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-red-500 to-rose-500 transition-all" style="width:85%"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-zap w-4 h-4 text-primary"
                    aria-hidden="true"
                  >
                    <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>
                  </svg>
                  <span class="font-medium">{gettext("Utilities")}</span>
                </div>
                <span class="text-sm font-semibold text-primary">$89.20</span>
              </div>
              <div class="w-full bg-muted h-2 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-yellow-500 to-amber-500 transition-all" style="width:45%"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-house w-4 h-4 text-primary"
                    aria-hidden="true"
                  >
                    <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
                    <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  </svg>
                  <span class="font-medium">{gettext("Rent")}</span>
                </div>
                <span class="text-sm font-semibold text-primary">$1,200</span>
              </div>
              <div class="w-full bg-muted h-2 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-blue-500 to-cyan-500 transition-all" style="width:100%"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="p-8 rounded-2xl border border-border bg-card/50">
          <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-secondary/10 flex items-center justify-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-trending-up w-4 h-4 text-secondary"
                aria-hidden="true"
              >
                <path d="M16 7h6v6"></path>
                <path d="m22 7-8.5 8.5-5-5L2 17"></path>
              </svg>
            </div>
            {gettext("Activity Feed")}
          </h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-3 rounded-lg bg-background/50 border border-border/30 hover:border-primary/30 transition-colors">
              <div>
                <p class="font-medium text-foreground">{gettext("Coffee at Brew Haven")}</p>
                <p class="text-xs text-muted-foreground">{gettext("Today, 2:45 PM")}</p>
              </div>
              <span class="font-semibold text-foreground">- $5.20</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-lg bg-background/50 border border-border/30 hover:border-primary/30 transition-colors">
              <div>
                <p class="font-medium text-foreground">{gettext("Salary Deposit")}</p>
                <p class="text-xs text-muted-foreground">{gettext("Today, 12:30 PM")}</p>
              </div>
              <span class="font-semibold text-primary">+ $3,500</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-lg bg-background/50 border border-border/30 hover:border-primary/30 transition-colors">
              <div>
                <p class="font-medium text-foreground">{gettext("Dinner at Pasta Place")}</p>
                <p class="text-xs text-muted-foreground">{gettext("Yesterday, 6:15 PM")}</p>
              </div>
              <span class="font-semibold text-foreground">- $24.80</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-lg bg-background/50 border border-border/30 hover:border-primary/30 transition-colors">
              <div>
                <p class="font-medium text-foreground">{gettext("Freelance Payment")}</p>
                <p class="text-xs text-muted-foreground">{gettext("Yesterday, 9:00 AM")}</p>
              </div>
              <span class="font-semibold text-primary">+ $250</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        {gettext("Ready to chat with your finances?")}
      </h2>
      <p class="text-lg text-muted-foreground mb-8 max-w-2xl mx-auto">
        {gettext("No account needed. Start asking questions about your finances right now.")}
      </p>
      <.link href={FinBotWeb.Helpers.WhatsApp.share_link("15551498199", gettext("I want to use FinBot"))}>
        <button class="px-8 py-4 rounded-lg bg-primary text-primary-foreground font-semibold text-lg hover:bg-primary/90 transition-all transform hover:scale-105 flex items-center gap-2 mx-auto">
          {gettext("Start Chatting Now")}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-chevron-right w-5 h-5"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </.link>
    </section>
  </main>

