<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- Header --%>
  <header
    class="border-b border-base-300 bg-base-200/50 backdrop-blur-sm -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl px-6 py-8 grid grid-cols-2 items-center gap-4" style="grid-template-columns: 1fr auto;">
      <div class="">
        <h1 class="text-4xl font-bold text-base-content">{gettext("My Finances")}</h1>
        <p class="mt-2 text-base-content/60">{@month_label}</p>
      </div>
      <%!-- Date Filter --%>
      
        <div class="flex flex-col gap-4 justify-center items-center">
          <span class="text-sm font-medium text-base-content/60">{gettext("Filter by period")}</span>
          <form id="date-filter-form" phx-change="filter_date" class="flex items-center gap-3 flex-wrap">
            <select
              id="filter-month"
              name="month"
              class="rounded-lg border border-base-300 bg-base-100 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            >
              <%= for {label, value} <- FinBotElixirWeb.DashLive.month_options() do %>
                <option value={value} selected={value == @filter_month}>{label}</option>
              <% end %>
            </select>
            <input
              id="filter-year"
              name="year"
              type="number"
              value={@filter_year}
              min="1900"
              max="2100"
              class="w-28 rounded-lg border border-base-300 bg-base-100 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </form>
        </div>
    </div>
  </header>

  
  <%= if @live_action==:index do %>

      <!--
      <section>
        <vanna-chat
            api-base="http://localhost:8000"
            sse-endpoint="http://localhost:8000/api/vanna/v2/chat_sse"
            ws-endpoint="http://localhost:8000/api/vanna/v2/chat_websocket"
            poll-endpoint="http://localhost:8000/api/vanna/v2/chat_poll">
        </vanna-chat>
      </section>
      -->

      <%!-- Summary Cards --%>
        <section
          class="border-b border-base-300 bg-gradient-to-b from-base-200/20 to-transparent -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-6xl px-6 py-8">
            <div class="grid gap-4 md:grid-cols-3">
              <%!-- Net Balance --%>
                <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                  <p class="text-sm font-medium text-base-content/60">{gettext("Net Balance")}</p>
                  <p class={[ "mt-2 text-3xl font-bold" , if(Decimal.compare(@net_balance, 0) !=:lt, do: "text-success" , else: "text-error" ) ]}>
                    R$ {FinBotElixirWeb.DashLive.format_currency(@net_balance)}
                  </p>
                </div>

                <%!-- Total Income --%>
                  <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                    <div class="flex items-center justify-between">
                      <div>
                        <p class="text-sm font-medium text-base-content/60">{gettext("Total Income")}</p>
                        <p class="mt-2 text-3xl font-bold text-success">
                          R$ {FinBotElixirWeb.DashLive.format_currency(@total_income)}
                        </p>
                      </div>
                      <.icon name="hero-arrow-down-left" class="h-8 w-8 text-success opacity-50" />
                    </div>
                  </div>

                  <%!-- Total Expenses --%>
                    <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                      <div class="flex items-center justify-between">
                        <div>
                          <p class="text-sm font-medium text-base-content/60">{gettext("Total Expenses")}</p>
                          <p class="mt-2 text-3xl font-bold text-error">
                            R$ {FinBotElixirWeb.DashLive.format_currency(@total_expenses)}
                          </p>
                        </div>
                        <.icon name="hero-arrow-up-right" class="h-8 w-8 text-error opacity-50" />
                      </div>
                    </div>
            </div>
          </div>
        </section>

        <%!-- Category Sections --%>
          <div class="mx-auto max-w-6xl px-6 py-12 -mx-4 sm:-mx-6 lg:-mx-8">
            <%!-- Expenses Section --%>
              <section class="mb-12">
                <div class="mb-6">
                  <h2 class="flex items-center gap-2 text-2xl font-bold text-base-content">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-error/10">
                      <.icon name="hero-arrow-up-right" class="h-5 w-5 text-error" />
                    </span>
                    {gettext("Expenses")}
                  </h2>
                </div>

                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                  <%= if @expense_categories==[] do %>
                    <div class="col-span-full rounded-lg border border-base-300 bg-base-200 p-8 text-center">
                      <p class="text-base-content/60">{gettext("No records for this period.")}</p>
                    </div>
                    <% end %>
                      <%= for cat <- @expense_categories do %>
                        <.link patch={~p"/dashboard/#{cat.name}"}
                          class="group relative overflow-hidden rounded-lg border border-base-300 bg-base-200 p-6 transition-all duration-300 hover:border-primary hover:bg-base-200/80 hover:shadow-lg hover:shadow-primary/10 active:scale-95">
                          <div
                            class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                          </div>
                          <div class="relative">
                            <div class="flex items-start justify-between">
                              <div class="flex-1">
                                <p class="text-sm font-medium text-base-content/60">
                                  {FinBotElixirWeb.DashLive.category_label(cat.name)}
                                </p>
                                <p class="mt-2 text-3xl font-bold text-error">
                                  R$ {FinBotElixirWeb.DashLive.format_currency(cat.total)}
                                </p>
                              </div>
                              <.icon name="hero-chevron-right"
                                class="h-5 w-5 text-base-content/40 transition-transform group-hover:translate-x-1" />
                            </div>
                            <p class="mt-4 text-xs text-base-content/40">
                              {cat.count} {ngettext("record", "records", cat.count)}
                            </p>
                          </div>
                        </.link>
                        <% end %>
                </div>
              </section>

              <%!-- Income Section --%>
                <section>
                  <div class="mb-6">
                    <h2 class="flex items-center gap-2 text-2xl font-bold text-base-content">
                      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-success/10">
                        <.icon name="hero-arrow-down-left" class="h-5 w-5 text-success" />
                      </span>
                      {gettext("Income")}
                    </h2>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                    <%= if @income_categories==[] do %>
                      <div class="col-span-full rounded-lg border border-base-300 bg-base-200 p-8 text-center">
                        <p class="text-base-content/60">{gettext("No records for this period.")}</p>
                      </div>
                      <% end %>
                        <%= for cat <- @income_categories do %>
                          <.link patch={~p"/dashboard/#{cat.name}"}
                            class="group relative overflow-hidden rounded-lg border border-base-300 bg-base-200 p-6 transition-all duration-300 hover:border-primary hover:bg-base-200/80 hover:shadow-lg hover:shadow-primary/10 active:scale-95">
                            <div
                              class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                            </div>
                            <div class="relative">
                              <div class="flex items-start justify-between">
                                <div class="flex-1">
                                  <p class="text-sm font-medium text-base-content/60">
                                    {FinBotElixirWeb.DashLive.category_label(cat.name)}
                                  </p>
                                  <p class="mt-2 text-3xl font-bold text-success">
                                    R$ {FinBotElixirWeb.DashLive.format_currency(cat.total)}
                                  </p>
                                </div>
                                <.icon name="hero-chevron-right"
                                  class="h-5 w-5 text-base-content/40 transition-transform group-hover:translate-x-1" />
                              </div>
                              <p class="mt-4 text-xs text-base-content/40">
                                {cat.count} {ngettext("record", "records", cat.count)}
                              </p>
                            </div>
                          </.link>
                          <% end %>
                  </div>
                </section>
          </div>
          <% else %>
            <%!-- Detail Header --%>
              <header
                class="border-b border-base-300 bg-base-200/50 backdrop-blur-sm -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
                <div class="mx-auto max-w-4xl px-6 py-8">
                  <.link patch={~p"/dashboard"}
                    class="mb-4 flex items-center gap-2 text-sm font-medium text-base-content/60 transition-colors hover:text-base-content">
                    <.icon name="hero-arrow-left" class="h-4 w-4" />
                    {gettext("Back")}
                  </.link>
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <h1 class="text-4xl font-bold text-base-content">{FinBotElixirWeb.DashLive.category_label(@category_name)}</h1>
                      <p class="mt-2 text-base-content/60">{@month_label}</p>
                    </div>
                    <div class={[ "flex h-12 w-12 items-center justify-center rounded-lg" , if(@category_type=="expense", do: "bg-error/10" , else: "bg-success/10" ) ]}>
                      <.icon name={if(@category_type=="expense" , do: "hero-arrow-up-right" ,
                        else: "hero-arrow-down-left" )} class={[ "h-6 w-6" , if(@category_type=="expense" ,
                        do: "text-error" , else: "text-success" ) ]} />
                    </div>
                  </div>
                </div>
              </header>

              <%!-- Category Total Card --%>
                <section
                  class="border-b border-base-300 bg-gradient-to-b from-base-200/20 to-transparent -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
                  <div class="mx-auto max-w-4xl px-6 py-8">
                    <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                      <p class="text-sm font-medium text-base-content/60">
                        {if @category_type == "expense", do: gettext("Total Spent"), else: gettext("Total Received")}
                      </p>
                      <p class={[ "mt-2 text-4xl font-bold" , if(@category_type=="expense" , do: "text-error" , else: "text-success" ) ]}>
                        R$ {FinBotElixirWeb.DashLive.format_currency(@category_total)}
                      </p>
                      <p class="mt-2 text-xs text-base-content/60">
                        {@transaction_count} {ngettext("record", "records", @transaction_count)}
                      </p>
                    </div>
                  </div>
                </section>

                <%!-- Transaction List --%>
                <section
                  class="border-b border-base-300 bg-gradient-to-b from-base-200/20 to-transparent -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">

                  <div class="mx-auto max-w-4xl px-6 py-8">
                    <div class="mb-6 flex items-center justify-between">
                      <h2 class="text-2xl font-bold text-base-content">{gettext("Records")}</h2>
                      <button
                        id="open-add-modal-btn"
                        phx-click="open_add_modal"
                        class="flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90 transition-colors"
                      >
                        <.icon name="hero-plus" class="h-4 w-4" />
                        {gettext("Add")}
                      </button>
                    </div>

                    <%= if @transaction_count == 0 do %>
                      <div class="rounded-lg border border-base-300 bg-base-200/50 p-8 text-center">
                        <p class="text-base-content/60">{gettext("No records found.")}</p>
                      </div>
                    <% else %>
                      <%!-- Shared tag autocomplete datalist --%>
                      <datalist id="tag-suggestions">
                        <%= for name <- @all_tags do %>
                          <option value={name} />
                        <% end %>
                      </datalist>
                      <div class="space-y-2" id="transactions-list">
                          <%= for t <- @transactions do %>
                            <div id={"transaction-#{t.id}"} class="rounded-lg border border-base-300 bg-base-200/50 transition-colors hover:bg-base-200">
                              <%= if t.id == @editing_id do %>
                                <%!-- Edit mode --%>
                                <.form for={@edit_form} id={"edit-form-#{t.id}"} phx-submit="save_transaction" class="p-4">
                                  <div class="flex items-center gap-3 flex-wrap">
                                    <div class="flex-1 min-w-0">
                                      <p class="text-sm font-medium text-base-content/60 mb-2 truncate">{t.description}</p>
                                      <div class="flex items-center gap-2 flex-wrap">
                                        <.input
                                          field={@edit_form[:description]}
                                          type="text"
                                          label={gettext("Description")}
                                          class="min-w-[12rem] flex-1 rounded-lg border border-base-300 bg-base-100 px-3 py-1.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                                        />
                                        <.input
                                          field={@edit_form[:amount]}
                                          type="number"
                                          step="0.01"
                                          min="0"
                                          label={gettext("Amount")}
                                          class="w-36 rounded-lg border border-base-300 bg-base-100 px-3 py-1.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                                        />
                                        <.input
                                          type="select"
                                          field={@edit_form[:category]}
                                          label={gettext("Category")}
                                          options={FinBotElixirWeb.DashLive.categories_for_type(@all_categories, t.type)}
                                          class="rounded-lg border border-base-300 bg-base-100 px-3 py-1.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                                        />
                                      </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                      <button
                                        type="submit"
                                        title={gettext("Save")}
                                        class="flex h-9 w-9 items-center justify-center rounded-lg bg-success/10 text-success hover:bg-success/20 transition-colors"
                                      >
                                        <.icon name="hero-archive-box-arrow-down" class="h-5 w-5" />
                                      </button>
                                      <button
                                        type="button"
                                        phx-click="cancel_edit"
                                        title={gettext("Cancel")}
                                        class="flex h-9 w-9 items-center justify-center rounded-lg bg-base-300/60 text-base-content/60 hover:bg-base-300 transition-colors"
                                      >
                                        <.icon name="hero-x-mark" class="h-5 w-5" />
                                      </button>
                                    </div>
                                  </div>
                                </.form>
                              <% else %>
                                <%!-- View mode --%>
                                <div class="flex items-center justify-between p-4">
                                  <div class="flex-1 min-w-0 mr-3">
                                    <p class="font-medium text-base-content truncate">{t.description}</p>
                                    <p class="text-sm text-base-content/60">
                                      {Calendar.strftime(t.inserted_at, "%b %d")}
                                    </p>
                                    <%!-- Tags badges --%>
                                    <div class="mt-2 flex flex-wrap items-center gap-1">
                                      <%= for tag <- t.tags do %>
                                        <span class="inline-flex items-center gap-0.5 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                                          {tag.name}
                                          <button
                                            type="button"
                                            phx-click="remove_tag"
                                            phx-value-transaction_id={t.id}
                                            phx-value-tag_name={tag.name}
                                            class="ml-0.5 rounded-full hover:bg-primary/20 transition-colors"
                                            title={gettext("Remove tag")}
                                          >
                                            <.icon name="hero-x-mark" class="h-3 w-3" />
                                          </button>
                                        </span>
                                      <% end %>
                                      <%!-- Add tag form --%>
                                      <form
                                        id={"add-tag-form-#{t.id}"}
                                        phx-submit="add_tag"
                                        class="inline-flex items-center gap-1"
                                      >
                                        <input type="hidden" name="transaction_id" value={t.id} />
                                        <input
                                          type="text"
                                          name="tag_name"
                                          list="tag-suggestions"
                                          placeholder={gettext("Add tag…")}
                                          autocomplete="off"
                                          class="rounded-full border border-dashed border-base-300 bg-transparent px-2 py-0.5 text-xs text-base-content/60 placeholder:text-base-content/40 focus:border-primary focus:outline-none focus:text-base-content w-24"
                                        />
                                      </form>
                                    </div>
                                  </div>
                                  <p class={["text-lg font-bold mr-3 shrink-0", if(t.type == "expense", do: "text-error", else: "text-success")]}>
                                    {if t.type == "expense", do: "-", else: "+"}R$
                                    {FinBotElixirWeb.DashLive.format_currency(t.amount)}
                                  </p>
                                  <div class="flex items-center gap-1 shrink-0">
                                    <button
                                      type="button"
                                      phx-click="edit_transaction"
                                      phx-value-id={t.id}
                                      title={gettext("Edit")}
                                      class="flex h-8 w-8 items-center justify-center rounded-lg text-base-content/40 hover:bg-primary/10 hover:text-primary transition-colors"
                                    >
                                      <.icon name="hero-pencil-square" class="h-4 w-4" />
                                    </button>
                                    <button
                                      type="button"
                                      phx-click="confirm_delete"
                                      phx-value-id={t.id}
                                      title={gettext("Delete")}
                                      class="flex h-8 w-8 items-center justify-center rounded-lg text-base-content/40 hover:bg-error/10 hover:text-error transition-colors"
                                    >
                                      <.icon name="hero-trash" class="h-4 w-4" />
                                    </button>
                                  </div>
                                </div>
                              <% end %>
                            </div>
                            <% end %>
                        </div>
                    <% end %>
                  </div>
                </section>


                <%!-- Delete Confirmation Modal --%>
                  <%= if @confirm_delete_id do %>
                    <div
                      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
                    >
                      <div
                        class="w-full max-w-sm rounded-2xl border border-base-300 bg-base-100 p-6 shadow-2xl mx-4"
                      >
                        <div class="flex items-center gap-3 mb-4">
                          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-error/10">
                            <.icon name="hero-trash" class="h-5 w-5 text-error" />
                          </span>
                          <h3 class="text-lg font-bold text-base-content">
                            {gettext("Delete Transaction")}
                          </h3>
                        </div>
                        <p class="text-sm text-base-content/60 mb-6">
                          {gettext("Are you sure you want to delete this transaction? This action cannot be undone.")}
                        </p>
                        <div class="flex justify-end gap-3">
                          <button
                            phx-click="cancel_delete"
                            class="rounded-lg border border-base-300 px-4 py-2 text-sm font-medium text-base-content/70 hover:bg-base-200 transition-colors"
                          >
                            {gettext("Cancel")}
                          </button>
                          <button
                            phx-click="delete_transaction"
                            phx-value-id={@confirm_delete_id}
                            class="rounded-lg bg-error px-4 py-2 text-sm font-medium text-white hover:bg-error/90 transition-colors"
                          >
                            {gettext("Delete")}
                          </button>
                        </div>
                      </div>
                    </div>
                  <% end %>
                  <%!-- Add Transaction Modal --%>
                  <%= if @show_add_modal do %>
                    <div
                      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
                    >
                      <div
                        class="w-full max-w-sm rounded-2xl border border-base-300 bg-base-100 p-6 shadow-2xl mx-4"
                      >
                        <div class="flex items-center gap-3 mb-4">
                          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                            <.icon name="hero-plus" class="h-5 w-5 text-primary" />
                          </span>
                          <h3 class="text-lg font-bold text-base-content">
                            {gettext("Add Transaction")}
                          </h3>
                        </div>
                        <.form for={@add_form} id="add-transaction-form" phx-submit="add_transaction">
                          <div class="space-y-4">
                            <.input
                              field={@add_form[:amount]}
                              type="number"
                              step="0.01"
                              min="0.01"
                              label={gettext("Amount")}
                              required={true}
                            />
                            <.input
                              field={@add_form[:description]}
                              type="text"
                              label={gettext("Description")}
                              required={true}
                            />
                          </div>
                          <div class="flex justify-end gap-3 mt-6">
                            <button
                              type="button"
                              phx-click="cancel_add"
                              class="rounded-lg border border-base-300 px-4 py-2 text-sm font-medium text-base-content/70 hover:bg-base-200 transition-colors"
                            >
                              {gettext("Cancel")}
                            </button>
                            <button
                              type="submit"
                              class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90 transition-colors"
                            >
                              {gettext("Add")}
                            </button>
                          </div>
                        </.form>
                      </div>
                    </div>
                  <% end %>
  <% end %>
</Layouts.app>