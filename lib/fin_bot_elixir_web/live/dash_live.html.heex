<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%= if @live_action==:index do %>
    <%!-- Header --%>
      <header
        class="border-b border-base-300 bg-base-200/50 backdrop-blur-sm -mx-4 sm:-mx-6 lg:-mx-8 -mt-20 px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl px-6 py-8">
          <h1 class="text-4xl font-bold text-base-content">My Finances</h1>
          <p class="mt-2 text-base-content/60">{@month_label}</p>
        </div>
      </header>

      <%!-- Summary Cards --%>
        <section
          class="border-b border-base-300 bg-gradient-to-b from-base-200/20 to-transparent -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-6xl px-6 py-8">
            <div class="grid gap-4 md:grid-cols-3">
              <%!-- Net Balance --%>
                <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                  <p class="text-sm font-medium text-base-content/60">Net Balance</p>
                  <p class={[ "mt-2 text-3xl font-bold" , if(Decimal.compare(@net_balance, 0) !=:lt, do: "text-success", else: "text-error" ) ]}>
                    R$ {FinBotElixirWeb.DashLive.format_currency(@net_balance)}
                  </p>
                </div>

                <%!-- Total Income --%>
                  <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                    <div class="flex items-center justify-between">
                      <div>
                        <p class="text-sm font-medium text-base-content/60">Total Income</p>
                        <p class="mt-2 text-3xl font-bold text-success">
                          R$ {FinBotElixirWeb.DashLive.format_currency(@total_income)}
                        </p>
                      </div>
                      <.icon name="hero-arrow-down-left" class="h-8 w-8 text-success opacity-50" />
                    </div>
                  </div>

                  <%!-- Total Expenses --%>
                    <div class="rounded-lg border border-base-300 bg-base-200 p-6">
                      <div class="flex items-center justify-between">
                        <div>
                          <p class="text-sm font-medium text-base-content/60">Total Expenses</p>
                          <p class="mt-2 text-3xl font-bold text-error">
                            R$ {FinBotElixirWeb.DashLive.format_currency(@total_expenses)}
                          </p>
                        </div>
                        <.icon name="hero-arrow-up-right" class="h-8 w-8 text-error opacity-50" />
                      </div>
                    </div>
            </div>
          </div>
        </section>

        <%!-- Category Sections --%>
          <div class="mx-auto max-w-6xl px-6 py-12 -mx-4 sm:-mx-6 lg:-mx-8">
            <%!-- Expenses Section --%>
              <section class="mb-12">
                <div class="mb-6">
                  <h2 class="flex items-center gap-2 text-2xl font-bold text-base-content">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-error/10">
                      <.icon name="hero-arrow-up-right" class="h-5 w-5 text-error" />
                    </span>
                    Expenses
                  </h2>
                </div>

                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                  <%= if @expense_categories==[] do %>
                    <div class="col-span-full rounded-lg border border-base-300 bg-base-200 p-8 text-center">
                      <p class="text-base-content/60">No expenses recorded this period.</p>
                    </div>
                    <% end %>
                      <%= for cat <- @expense_categories do %>
                        <.link patch={~p"/dashboard/#{cat.name}"}
                          class="group relative overflow-hidden rounded-lg border border-base-300 bg-base-200 p-6 transition-all duration-300 hover:border-primary hover:bg-base-200/80 hover:shadow-lg hover:shadow-primary/10 active:scale-95">
                          <div
                            class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                          </div>
                          <div class="relative">
                            <div class="flex items-start justify-between">
                              <div class="flex-1">
                                <p class="text-sm font-medium text-base-content/60">{cat.name}</p>
                                <p class="mt-2 text-3xl font-bold text-error">
                                  R$ {FinBotElixirWeb.DashLive.format_currency(cat.total)}
                                </p>
                              </div>
                              <.icon name="hero-chevron-right"
                                class="h-5 w-5 text-base-content/40 transition-transform group-hover:translate-x-1" />
                            </div>
                            <p class="mt-4 text-xs text-base-content/40">
                              {cat.count} {if cat.count == 1, do: "transaction", else: "transactions"}
                            </p>
                          </div>
                        </.link>
                        <% end %>
                </div>
              </section>

              <%!-- Income Section --%>
                <section>
                  <div class="mb-6">
                    <h2 class="flex items-center gap-2 text-2xl font-bold text-base-content">
                      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-success/10">
                        <.icon name="hero-arrow-down-left" class="h-5 w-5 text-success" />
                      </span>
                      Incomes
                    </h2>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                    <%= if @income_categories==[] do %>
                      <div class="col-span-full rounded-lg border border-base-300 bg-base-200 p-8 text-center">
                        <p class="text-base-content/60">No income recorded this period.</p>
                      </div>
                      <% end %>
                        <%= for cat <- @income_categories do %>
                          <.link patch={~p"/dashboard/#{cat.name}"}
                            class="group relative overflow-hidden rounded-lg border border-base-300 bg-base-200 p-6 transition-all duration-300 hover:border-primary hover:bg-base-200/80 hover:shadow-lg hover:shadow-primary/10 active:scale-95">
                            <div
                              class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                            </div>
                            <div class="relative">
                              <div class="flex items-start justify-between">
                                <div class="flex-1">
                                  <p class="text-sm font-medium text-base-content/60">{cat.name}</p>
                                  <p class="mt-2 text-3xl font-bold text-success">
                                    R$ {FinBotElixirWeb.DashLive.format_currency(cat.total)}
                                  </p>
                                </div>
                                <.icon name="hero-chevron-right"
                                  class="h-5 w-5 text-base-content/40 transition-transform group-hover:translate-x-1" />
                              </div>
                              <p class="mt-4 text-xs text-base-content/40">
                                {cat.count} {if cat.count == 1, do: "transaction", else: "transactions"}
                              </p>
                            </div>
                          </.link>
                          <% end %>
                  </div>
                </section>
          </div>
          <% else %>
            <%!-- Transaction Detail View --%>
              <div class="mx-auto max-w-6xl px-6 py-8">
                <.link patch={~p"/dashboard"}
                  class="inline-flex items-center gap-1 text-sm text-primary hover:text-primary/80 transition-colors">
                  <.icon name="hero-arrow-left" class="h-4 w-4" />
                  Back to Dashboard
                </.link>

                <h1 class="text-3xl font-bold text-base-content mt-4 mb-2">{@category_name}</h1>
                <p class="text-base-content/60 mb-8">Transaction details</p>

                <div class="rounded-lg border border-base-300 bg-base-200 overflow-hidden">
                  <%= if @transactions==[] do %>
                    <div class="p-8 text-center">
                      <p class="text-base-content/60">No transactions found.</p>
                    </div>
                    <% end %>
                      <%= for t <- @transactions do %>
                        <div
                          class="flex items-center justify-between p-4 border-b border-base-300 last:border-b-0 hover:bg-base-300/30 transition-colors">
                          <div class="flex-1">
                            <p class="font-medium text-base-content">{t.description}</p>
                            <p class="text-xs text-base-content/40 mt-1">
                              {Calendar.strftime(t.inserted_at, "%d/%m/%Y %H:%M")}
                            </p>
                          </div>
                          <p class={[ "font-bold text-lg" , if(t.type=="expense" , do: "text-error" ,
                            else: "text-success" ) ]}>
                            {if t.type == "expense", do: "-", else: "+"}R$
                            {FinBotElixirWeb.DashLive.format_currency(t.amount)}
                          </p>
                        </div>
                        <% end %>
                </div>
              </div>
              <% end %>
</Layouts.app>